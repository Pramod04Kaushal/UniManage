@model UniManage.Models.StudentChatPageViewModel

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/Messages.css"
      asp-append-version="true" />

<script>
    document.body.classList.add("messages-page");
</script>

<div class="chat-container">

    <!-- LEFT SIDEBAR -->

    <div class="chat-sidebar">

        <div class="search-box">
            <input type="text"
                   id="chatSearch"
                   placeholder="Search Chats..." />
        </div>

        <div class="chat-list">

            <div class="chat-section-title">
                Lecturers
            </div>

            @foreach (var lecturer in Model.Lecturers)
            {
                <a class="chat-user searchable-chat"
                   data-name="@lecturer.LecturerName"
                   href="@Url.Action("PrivateChat",
                                     new { lecturerUserId = lecturer.LecturerUserID })">

                @if (!string.IsNullOrEmpty(lecturer.ProfileImage))
                    {
                        <img src="~/images/@lecturer.ProfileImage"
                             class="group-avatar" />
                    }
                    else
                    {
                        <img src="~/images/default-user.png"
                             class="group-avatar" />
                    }

                    <div class="chat-user-info">

                        <div class="chat-top">

                            <h6>@lecturer.LecturerName</h6>

                        @if (lecturer.UnreadCount > 0)
                            {
                                <span class="chat-badge">
                                    @lecturer.UnreadCount
                                </span>
                            }

                        </div>

                        <small>
                            @lecturer.Department
                        </small>

                    </div>

                </a>
                        }

            <div class="chat-section-title">
                Group Chats
            </div>

            @foreach (var group in Model.Groups)
            {
                <a class="chat-user searchable-chat"
                   data-name="@group.CourseName @group.BatchName"
                   href="@Url.Action("Messages",
                                     new { groupId = group.GroupID })">

                <img src="~/images/logo.png"
                     class="group-avatar" />

                    <div>
                        <h6>
                            @group.CourseName | @group.BatchName
                        </h6>

                        <small>
                            Group Chat
                        </small>
                    </div>

                </a>
                        }

        </div>

    </div>

    <!-- RIGHT CHAT AREA -->

    <div class="chat-main">

        @if (ViewBag.IsPrivateChat == true)
        {
            <!-- PRIVATE CHAT -->

            <div class="chat-header">

                @{
                    var selectedLecturer =
                    Model.Lecturers.FirstOrDefault(l =>
                    l.LecturerUserID == ViewBag.LecturerUserId);
                }

                @if (selectedLecturer != null &&
                            !string.IsNullOrEmpty(selectedLecturer.ProfileImage))
                {
                    <img src="~/images/@selectedLecturer.ProfileImage"
                         class="group-avatar" />
                }
                else
                {
                    <img src="~/images/default-user.png"
                         class="group-avatar" />
                }

                <div>
                    <h5>@ViewBag.LecturerName</h5>
                    <small>Lecturer</small>
                </div>

            </div>

            <div class="chat-body">

                @if (ViewBag.PrivateMessages != null)
                {
                    foreach (var message in ViewBag.PrivateMessages)
                    {
                        <div class="message @(message.SenderUserID == Context.Session.GetInt32("UserID")
                                                             ? "sent"
                                                             : "received")">

                @if (message.SenderUserID != Context.Session.GetInt32("UserID"))
                            {
                                <div class="sender-info">
                                    <strong>@message.SenderName</strong>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.MessageText))
                            {
                                <div>
                                    @message.MessageText
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.FilePath))
                            {
                                var extension =
                                System.IO.Path.GetExtension(message.FileName)
                                .ToLower();

                                @if (extension == ".jpg" ||
                                                extension == ".jpeg" ||
                                                extension == ".png" ||
                                                extension == ".gif" ||
                                                extension == ".webp")
                                {
                                    <img src="@message.FilePath"
                                         class="chat-image" />
                                }
                                else
                                {
                                    <a href="@message.FilePath"
                                       target="_blank"
                                       class="chat-file">

                                        <i class="fas fa-file"></i>
                                        @message.FileName

                                    </a>
                                }
                            }

                            <div class="message-time">
                                @message.SentAt.ToString("hh:mm tt")
                            </div>

                        </div>
                    }
                }

            </div>

            <form method="post"
                  asp-action="SendPrivateMessage"
                  asp-controller="Student"
                  enctype="multipart/form-data"
                  class="chat-footer">

                <input type="hidden"
                       name="lecturerUserId"
                       value="@ViewBag.LecturerUserId" />

                <label for="privateFileInput"
                       class="attach-btn">

                    <i class="fas fa-paperclip"></i>

                </label>

                <input type="file"
                       id="privateFileInput"
                       name="file"
                       style="display:none;" />

                <span id="privateSelectedFile" class="selected-file"></span>

                <input type="text"
                       name="messageText"
                       placeholder="Type message..." />

                <button type="submit">
                    <i class="fas fa-paper-plane"></i>
                </button>

            </form>
        }
        else if (ViewBag.SelectedGroupId != null)
        {
            <!-- GROUP CHAT -->

            <div class="chat-header">

                <img src="~/images/logo.png"
                     class="group-avatar" />

                <div>
                    <h5>@ViewBag.CourseName</h5>
                    <small>@ViewBag.BatchName</small>
                </div>

            </div>

            <div class="chat-body">

                @if (ViewBag.Messages != null)
                {
                    @foreach (var message in ViewBag.Messages)
                    {
                        <div class="message @(message.SenderUserID == Context.Session.GetInt32("UserID")
                                                     ? "sent"
                                                     : "received")">

                @if (message.SenderUserID != Context.Session.GetInt32("UserID"))
                            {
                                <div class="sender-info">
                                    <strong>@message.SenderName</strong>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.MessageText))
                            {
                                <div>
                                    @message.MessageText
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.FilePath))
                            {
                                var extension =
                                System.IO.Path.GetExtension(message.FileName)
                                .ToLower();

                                @if (extension == ".jpg" ||
                                                extension == ".jpeg" ||
                                                extension == ".png" ||
                                                extension == ".gif" ||
                                                extension == ".webp")
                                {
                                    <img src="@message.FilePath"
                                         class="chat-image" />
                                }
                                else
                                {
                                    <a href="@message.FilePath"
                                       target="_blank"
                                       class="chat-file">

                                        <i class="fas fa-file"></i>
                                        @message.FileName

                                    </a>
                                }
                            }

                            <div class="message-time">
                                @message.SentAt.ToString("hh:mm tt")
                            </div>

                        </div>
                    }
                }

            </div>

            <form asp-controller="Student"
                  asp-action="SendMessage"
                  method="post"
                  enctype="multipart/form-data"
                  class="chat-footer">

                <input type="hidden"
                       name="groupId"
                       value="@ViewBag.SelectedGroupId" />

                <label for="groupFileInput"
                       class="attach-btn">

                    <i class="fas fa-paperclip"></i>

                </label>

                <input type="file"
                       id="groupFileInput"
                       name="file"
                       style="display:none;" />

                <span id="groupSelectedFile" class="selected-file"></span>

                <input type="text"
                       name="messageText"
                       placeholder="Type message..." />

                <button type="submit">
                    <i class="fas fa-paper-plane"></i>
                </button>

            </form>
        }
        else
        {
            <div class="empty-chat">

                <i class="fas fa-comments"></i>

                <h5>
                    Select a chat to start messaging
                </h5>

            </div>
        }

    </div>

</div>


<script>
    document.getElementById("privateFileInput")
    ?.addEventListener("change", function () {

        if (this.files.length > 0) {
            document.getElementById("privateSelectedFile")
                .innerText = this.files[0].name;
        }

    });

    document.getElementById("groupFileInput")
    ?.addEventListener("change", function () {

        if (this.files.length > 0) {
            document.getElementById("groupSelectedFile")
                .innerText = this.files[0].name;
        }

    });
</script>


<script>
    document.getElementById("chatSearch")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            document
                .querySelectorAll(".searchable-chat")
                .forEach(function (chat) {

                    let name =
                        chat.dataset.name.toLowerCase();

                    if (name.includes(value)) {
                        chat.style.display = "flex";
                    }
                    else {
                        chat.style.display = "none";
                    }
                });
        });
</script>