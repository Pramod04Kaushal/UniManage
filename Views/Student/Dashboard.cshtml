@model List<UniManage.Models.Course>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Student Dashboard";
}

<div class="dashboard-container">

    <!-- STUDENT PROFILE -->

    <div class="welcome-banner"
         ondblclick="location.href='@Url.Action("Profile", "Student")'">

        <div class="welcome-left">

            <div class="avatar">
                <i class="fas fa-user-graduate"></i>
            </div>

            <div>

                <h1>
                    Welcome Back,
                    @ViewBag.StudentName
                </h1>

                <p>
                    @ViewBag.RegNum •
                    @ViewBag.Department •
                    Semester @ViewBag.Semester
                </p>

            </div>

        </div>

        <div class="welcome-right">

            <span class="gpa-label">
                Academic Progress
            </span>

            <h2>
                @ViewBag.Progress%
            </h2>

        </div>

    </div>



    <!-- DASHBOARD CARDS -->

    <div class="dashboard-cards">

        <div class="dashboard-card courses-card">

            <div class="card-icon">
                <i class="fas fa-book"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.TotalCourses</h2>

                <p>Enrolled Courses</p>

            </div>

        </div>

        <div class="dashboard-card modules-card">

            <div class="card-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.TotalModules</h2>

                <p>Total Modules</p>

            </div>

        </div>

        <div class="dashboard-card assignments-card">

            <div class="card-icon">
                <i class="fas fa-tasks"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.PendingAssignments</h2>

                <p>Pending Assignments</p>

            </div>

        </div>

        <div class="dashboard-card grades-card">

            <div class="card-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.AverageGrade%</h2>

                <p>Average Grade</p>

            </div>

        </div>

    </div>

    <!-- NOTIFICATIONS -->



    <!-- UPCOMING ASSIGNMENTS -->

    <div class="dashboard-row">

        <div class="dashboard-widget">

            <div class="widget-header">
                <h2 class="upcoming-header">
                    Upcoming Assignments
                </h2>
            </div>

            <div class="assignment-item">

                <div>
                    <h4>Application Development</h4>
                    <p>Coursework 01</p>
                </div>

                <span class="assignment-date">
                    15 Jun 2026
                </span>

            </div>

            <div class="assignment-item">

                <div>
                    <h4>ASE</h4>
                    <p>Coursework 02</p>
                </div>

                <span class="assignment-date">
                    20 Jun 2026
                </span>

            </div>

        </div>

    <!-- RECENT GRADES -->

        <div class="dashboard-widget">

            <div class="widget-header">
                <h2 class="grades-header">
                    Recent Grades
                </h2>
            </div>

            <div class="grade-item">

                <div>
                    <h4>Final Project</h4>
                </div>

                <div class="grade-pending">
                    Pending
                </div>

            </div>

            <div class="grade-item">

                <div>
                    <h4>Software Engineering</h4>
                </div>

                <div class="grade-score">
                    75%
                </div>

            </div>

        </div>

    </div>





</div>

