@model List<UniManage.Models.Course>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Student Dashboard";
}

<div class="dashboard-container">

    <!-- STUDENT PROFILE -->

    <div class="welcome-banner"
         ondblclick="location.href='@Url.Action("Profile", "Student")'">

        <div class="welcome-left">

            <div class="avatar">
                <i class="fas fa-user-graduate"></i>
            </div>

            <div>

                <h1>
                    Welcome Back,
                    @ViewBag.StudentName
                </h1>

                <p>
                    @ViewBag.RegNum •
                    @ViewBag.CourseName •
                    Semester @ViewBag.Semester
                </p>

            </div>

        </div>

        <div class="welcome-right">

            <span class="gpa-label">
                Academic Progress
            </span>

            <h2>
                @ViewBag.Progress%
            </h2>

        </div>

    </div>



    <!-- DASHBOARD CARDS -->

    <div class="dashboard-cards">

        <div class="dashboard-card courses-card">

            <div class="card-icon">
                <i class="fas fa-book"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.TotalCourses</h2>

                <p>Enrolled Courses</p>

            </div>

        </div>

        <div class="dashboard-card modules-card">

            <div class="card-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.TotalModules</h2>

                <p>Total Modules</p>

            </div>

        </div>

        <div class="dashboard-card assignments-card"
             onclick="location.href='@Url.Action("Assignments", "Student")'">

            <div class="card-icon">
                <i class="fas fa-tasks"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.PendingAssignments</h2>

                <p>Pending Assignments</p>

            </div>

        </div>

        <div class="dashboard-card grades-card">

            <div class="card-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div class="card-content">

                <h2>@ViewBag.AverageGrade%</h2>

                <p>Average Grade</p>

            </div>

        </div>

    </div>

    <!-- NOTIFICATIONS -->



    <!-- UPCOMING ASSIGNMENTS -->

    <div class="dashboard-row">

        <div class="dashboard-widget">

            <div class="widget-header">
                <h2 class="upcoming-header">
                    Upcoming Assignments
                </h2>
            </div>

            @if (ViewBag.UpcomingAssignments.Count > 0)
            {
                @foreach (var assignment in ViewBag.UpcomingAssignments)
                {
                    <div class="assignment-item">

                        <div>
                            <h4>
                                <a asp-action="ViewAssignment"
                                   asp-route-id="@assignment.AssignmentID"
                                   class="assignment-link">

                                    @assignment.Title

                                </a>
                            </h4>

                            <p>@assignment.CourseName</p>
                        </div>

                        <span class="assignment-date">
                            @assignment.Deadline.ToString("dd MMM yyyy")
                        </span>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <i class="fas fa-exclamation-circle empty-icon"></i>

                    <h4>No Upcoming Assignments</h4>

                    <p>
                        You currently have no pending assignments.
                        New assignments will appear here when lecturers publish them.
                    </p>

                </div>
            }

        </div>

    <!-- RECENT GRADES -->

        <div class="dashboard-widget">

            <div class="widget-header">
                <h2 class="grades-header">
                    Recent Grades
                </h2>
            </div>

            @if (ViewBag.RecentGrades.Count > 0)
            {
                @foreach (var grade in ViewBag.RecentGrades)
                {
                    <div class="grade-item">

                        <div>
                            <h4>@grade.AssignmentTitle</h4>
                        </div>

                        @if (grade.Grade != null)
                        {
                            <div class="grade-score">
                                @grade.Grade%
                            </div>
                        }
                        else
                        {
                            <div class="grade-pending">
                                Pending
                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <i class="fas fa-chart-line empty-icon"></i>

                    <h4>No Grades Available</h4>

                    <p>
                        Your graded assignments will appear here once
                        lecturers have reviewed and published the results.
                    </p>

                </div>
            }

        </div>

        </div>

    </div>





</div>

