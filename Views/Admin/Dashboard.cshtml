@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}





<div class="cards">

    <div class="card">


        <h3>Total Students</h3>

        <p>@ViewBag.TotalStudents</p>

    </div>

    <div class="card">

        <h3>Total Lecturers</h3>

        <p>@ViewBag.TotalLecturers</p>

    </div>

    <div class="card">

        <h3>Total Courses</h3>

        <p>@ViewBag.TotalCourses</p>

    </div>

    <div class="card">

        <h3>Total Enrollments</h3>

        <p>@ViewBag.TotalEnrollments</p>




    </div>

</div>