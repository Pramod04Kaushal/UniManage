@model UniManage.Models.AddStudentViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Student";
}

<div class="page-header">

    <h1>Edit Student</h1>

    <p>
        Update student account information
    </p>

</div>

<div class="form-container">

    <form asp-action="EditStudent" method="post" enctype="multipart/form-data">

        <input type="hidden"
               asp-for="UserID" />

        <!-- PROFILE PICTURE -->

        <div class="profile-upload-section">

            <div class="profile-preview">

                <img id="profilePreview"
                     src="@(string.IsNullOrEmpty(Model.ProfileImage)
                                       ? "/images/default-user.png"
                                       : "/images/" + Model.ProfileImage)"
                     alt="Profile Preview" />

            </div>

            <div class="upload-controls">

                <label class="upload-btn">

                    Upload Profile Picture

                    <input type="file"
                           asp-for="ProfileImageFile"
                           id="profileImageInput"
                           accept="image/*"
                           hidden />

                </label>

                <p class="upload-text">
                    JPG, PNG or JPEG
                </p>

            </div>

        </div>

        <!-- PERSONAL INFORMATION -->

        <div class="form-section">

            <h2>Personal Information</h2>

            <div class="form-grid">

                <div class="form-group">
                    <label>Full Name</label>

                    <input type="text"
                           asp-for="FullName"
                           class="form-control"
                           placeholder="Enter full name" />
                </div>

                <div class="form-group">
                    <label>Email Address</label>

                    <input type="email"
                           asp-for="Email"
                           class="form-control"
                           placeholder="Enter email address" />
                </div>

                <div class="form-group">
                    <label>Address</label>

                    <input type="text"
                           asp-for="Address"
                           class="form-control"
                           placeholder="Enter Home Address" />
                </div>

                <div class="form-group">
                    <label>Phone Number</label>

                    <input type="text"
                           asp-for="Phone"
                           class="form-control"
                           placeholder="Enter phone number" />
                </div>

                <div class="form-group">
                    <label>Date of Birth</label>

                    <input type="date"
                           asp-for="DateOfBirth"
                           class="form-control" />
                </div>

                <div class="form-group">

                    <label>Gender</label>

                    <select asp-for="Gender"
                            class="form-control">

                        <option>Male</option>
                        <option>Female</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- ACADEMIC INFORMATION -->

        <div class="form-section">

            <h2>Academic Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Department</label>

                    <select id="departmentDropdown"
                            asp-for="Department"
                            class="form-control">

                        <option value="">
                            Select Department
                        </option>

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department.DepartmentName">
                                @department.DepartmentName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Course</label>

                    <select id="courseDropdown"
                            asp-for="Course"
                            class="form-control">

                        <option value="@Model.Course">
                            @Model.Course
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label>Batch</label>

                    <select id="batchDropdown"
                            name="BatchID"
                            class="form-control">

                        @foreach (var batch in ViewBag.Batches)
                        {
                            if (batch.BatchID == Model.BatchID)
                            {
                                <option value="@batch.BatchID" selected>
                                    @batch.BatchName
                                </option>
                            }
                            else
                            {
                                <option value="@batch.BatchID">
                                    @batch.BatchName
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Semester</label>

                    <select asp-for="Semester"
                            class="form-control">

                        <option value="1">Semester 1</option>
                        <option value="2">Semester 2</option>
                        <option value="3">Semester 3</option>
                        <option value="4">Semester 4</option>

                    </select>

                </div>

                <div class="form-group">

                    <label>Enrollment Year</label>

                    <input type="number"
                           asp-for="EnrollmentYear"
                           class="form-control"
                           placeholder="2026" />
                </div>

            </div>

        </div>

        <!-- ACCOUNT INFORMATION -->

        <div class="form-section">

            <h2>Account Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Status</label>

                    <select asp-for="Status"
                            class="form-control">

                        <option>Active</option>
                        <option>Inactive</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- BUTTONS -->

        <div class="button-group">

            <a href="/Admin/Users"
               class="cancel-btn">

                Cancel

            </a>

            <button type="submit"
                    class="save-btn">

                Update Student

            </button>

        </div>

    </form>

</div>

<script>

    const profileInput =
        document.getElementById("profileImageInput");

    const profilePreview =
        document.getElementById("profilePreview");

    profileInput.addEventListener("change", function () {

        const file = this.files[0];

        if (file) {

            const reader = new FileReader();

            reader.onload = function (e) {

                profilePreview.src = e.target.result;

            }

            reader.readAsDataURL(file);

        }

    });

</script>

<script>

    document.getElementById("departmentDropdown")
        .addEventListener("change", function () {

            let department = encodeURIComponent(this.value);

            fetch('/Admin/GetCoursesByDepartment?department=' + department)
                .then(response => response.json())
                .then(data => {

                    let courseDropdown =
                        document.getElementById("courseDropdown");

                    courseDropdown.innerHTML = "";

                    data.forEach(course => {

                        courseDropdown.innerHTML +=
                            `<option value="${course.courseName}">
                                ${course.courseName}
                             </option>`;

                    });

                });

        });

</script>

<script>

    document.getElementById("courseDropdown")
        .addEventListener("change", function () {

            let courseName =
                encodeURIComponent(this.value);

            fetch('/Admin/GetBatchesByCourse?courseName=' + courseName)
                .then(response => response.json())
                .then(data => {

                    let batchDropdown =
                        document.getElementById("batchDropdown");

                    batchDropdown.innerHTML =
                        '<option value="">Select Batch</option>';

                    data.forEach(batch => {

                        batchDropdown.innerHTML +=
                            `<option value="${batch.batchID}">
                                ${batch.batchName}
                             </option>`;

                    });

                });

        });

</script>