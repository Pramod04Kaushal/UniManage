@model List<UniManage.Models.Course>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Courses";
}

<div class="table-container">

    <div class="table-top">

        <!-- FILTER -->

        <form method="get">

            <select name="departmentFilter"
                    class="filter-dropdown"
                    onchange="this.form.submit()">

                <option value="ALL">ALL</option>

                @foreach (var department in ViewBag.Departments)
                {
                    <option value="@department.DepartmentName"
                            selected="@(Context.Request.Query["departmentFilter"] == department.DepartmentName ? "selected" : null)">

                        @department.DepartmentName

                    </option>
                }

            </select>

        </form>

        <!-- SEARCH -->

        <div class="table-search">

            <input type="text"
                   id="searchInput"
                   placeholder="Search courses..." />

        </div>

        <!-- ADD COURSE -->

        <a href="/Admin/AddCourse"
           class="add-user-btn">

            Add Course

        </a>

    </div>

    <table>

        <thead>

            <tr>


                <th>Course Code</th>
                <th>Course Name</th>
                <th>Department</th>
                <th>Qualification</th>
                <th>Duration</th>
                <th>Semesters</th>
                <th>Course Fee</th>
                <th>Intake</th>
                <th>Status</th>
                <th>Actions</th>

            </tr>

        </thead>

        <tbody id="coursesTable">

            @foreach (var course in Model)
            {
                <tr ondblclick="window.location='/Admin/ViewCourse/@course.CourseID'"
                    style="cursor:pointer;">



                    <td>@course.CourseCode</td>

                    <td>@course.CourseName</td>

                    <td>@course.Department</td>

                    <td>@course.QualificationType</td>

                    <td>@course.Duration</td>

                    <td>@course.Semesters</td>

                    <td>Rs. @course.CourseFee</td>

                    <td>@course.Intake</td>

                    <td>

                        <span class="@(course.Status == "Inactive"
                                      ? "status-inactive"
                                      : "status-active")">

                            @(string.IsNullOrEmpty(course.Status)
                                                    ? "Active"
                                                    : course.Status)

                    </span>

                    </td>

                    <td onclick="event.stopPropagation();">

                        <div class="action-dropdown">

                            <button type="button"
                                    class="action-btn"
                                    onclick="toggleDropdown(event, this)">

                                ⋮

                            </button>

                            <div class="dropdown-content">

                                <a href="/Admin/ViewCourse/@course.CourseID">
                                    View
                                </a>

                                <a href="/Admin/EditCourse/@course.CourseID">
                                    Edit
                                </a>

                                <a href="/Admin/DisableCourse/@course.CourseID"
                                   onclick="return confirm('Change course status?');">

                                    @(course.Status == "Inactive"
                                                                    ? "Enable"
                                                                    : "Disable")

                            </a>

                                <a href="/Admin/DeleteCourse/@course.CourseID"
                                   onclick="return confirm('Delete this course permanently?');">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </td>

                </tr>


            }

        </tbody>

    </table>

</div>


<script>

    const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("#coursesTable tr");

        rows.forEach(row => {

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";

        });

    });

</script>


<script>

    function toggleDropdown(event, button)
    {
        event.stopPropagation();

        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                if (menu !== button.nextElementSibling)
                {
                    menu.classList.remove("show");
                }
            });

        button.nextElementSibling
            .classList.toggle("show");
    }

    document.addEventListener("click", function ()
    {
        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                menu.classList.remove("show");
            });
    });

</script>