@model List<UniManage.Models.Module>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Modules";
}

<div class="table-container">

    <div class="table-top">

        <!-- FILTER -->

        <form method="get">

            <select name="departmentFilter"
                    class="filter-dropdown"
                    onchange="this.form.submit()">

                <option value="ALL">ALL</option>

                @foreach (var department in ViewBag.Departments)
                {
                    <option value="@department.DepartmentName"
                            selected="@(Context.Request.Query["departmentFilter"] == department.DepartmentName ? "selected" : null)">

                        @department.DepartmentName

                    </option>
                }

            </select>

        </form>

        <!-- SEARCH -->

        <div class="table-search">

            <input type="text"
                   id="searchInput"
                   placeholder="Search modules..." />

        </div>

        <!-- ADD MODULE -->

        <a href="/Admin/AddModule"
           class="add-user-btn">

            Add Module

        </a>

    </div>

    <table>

        <thead>

            <tr>

                <th>Module Code</th>
                <th>Module Name</th>
            
                <th>Department</th>
            
                <th>Credits</th>


                <th>Status</th>
                <th>Actions</th>

            </tr>

        </thead>

        <tbody id="modulesTable">

            @foreach (var module in Model)
            {
                <tr ondblclick="window.location='/Admin/ViewModule/@module.ModuleID'"
                    style="cursor:pointer;">

                    <td>@module.ModuleCode</td>

                    <td>@module.ModuleName</td>

             

                    <td>@module.Department</td>

           

                    <td>@module.Credits</td>





                    <td>

                        <span class="@(module.Status == "Inactive"
                                      ? "status-inactive"
                                      : "status-active")">

                            @(string.IsNullOrEmpty(module.Status)
                                                    ? "Active"
                                                    : module.Status)

                    </span>

                    </td>

                    <td onclick="event.stopPropagation();">

                        <div class="action-dropdown">

                            <button type="button"
                                    class="action-btn"
                                    onclick="toggleDropdown(event, this)">

                                ⋮

                            </button>

                            <div class="dropdown-content">

                                <a href="/Admin/ViewModule/@module.ModuleID">
                                    View
                                </a>

                                <a href="/Admin/EditModule/@module.ModuleID">
                                    Edit
                                </a>

                                <a href="/Admin/DisableModule/@module.ModuleID">

                                    @(module.Status == "Inactive"
                                                                    ? "Enable"
                                                                    : "Disable")

                            </a>

                                <a href="/Admin/DeleteModule/@module.ModuleID"
                                   onclick="return confirm('Delete this module permanently?');">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<script>

    const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("#modulesTable tr");

        rows.forEach(row => {

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";

        });

    });

</script>

<script>

    function toggleDropdown(event, button)
    {
        event.stopPropagation();

        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                if (menu !== button.nextElementSibling)
                {
                    menu.classList.remove("show");
                }
            });

        button.nextElementSibling
            .classList.toggle("show");
    }

    document.addEventListener("click", function ()
    {
        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                menu.classList.remove("show");
            });
    });

</script>