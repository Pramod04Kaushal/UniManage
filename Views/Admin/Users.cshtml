@model List<UniManage.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
}




<div class="table-container">

    <div class="table-top">

        <!-- FILTER -->

        <form method="get">

            <select name="roleFilter"
                    class="filter-dropdown"
                    onchange="this.form.submit()">

                <option value="ALL"
                        selected="@(Context.Request.Query["roleFilter"] == "ALL" || string.IsNullOrEmpty(Context.Request.Query["roleFilter"]) ? "selected" : null)">
                    ALL
                </option>

                <option value="Student"
                        selected="@(Context.Request.Query["roleFilter"] == "Student" ? "selected" : null)">
                    Students
                </option>

                <option value="Lecturer"
                        selected="@(Context.Request.Query["roleFilter"] == "Lecturer" ? "selected" : null)">
                    Lecturers
                </option>

                <option value="Admin"
                        selected="@(Context.Request.Query["roleFilter"] == "Admin" ? "selected" : null)">
                    Administrator
                </option>

            </select>

        </form>

        <!-- SEARCH -->

        <div class="table-search">

            <input type="text"
                   id="searchInput"
                   placeholder="Search users..." />

        </div>

        <!-- ADD USER -->

        <button id="openModalBtn"
                class="add-user-btn">

            Add User

        </button>

    </div>



    <table>

        <thead>

            <tr>

                <th>ID</th>

                <th>Full Name</th>

                <th>Department</th>

                <th>Role</th>

                <th>Email</th>

                <th>Phone</th>

                <th>Status</th>

                <th>Created Date</th>

                <th>Actions</th>

                

            </tr>

        </thead>

        <tbody id="usersTable">

            @foreach (var user in Model)
            {
                <tr ondblclick="window.location='/Admin/UserDetails/@user.UserID'"
                    style="cursor:pointer;">

                    <td>@user.UserID</td>

                    <td>@user.FullName</td>

                    <td>@user.Department</td>

                    <td>@user.Role</td>

                    <td>@user.Email</td>

                    <td>@user.Phone</td>

                    <td>

                        <span class="@(user.Status == "Inactive"
                                  ? "status-inactive"
                                  : "status-active")">

                            @(string.IsNullOrEmpty(user.Status)
                                                    ? "Active"
                                                    : user.Status)

                    </span>

                    </td>

                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>

                    <td onclick ="event.stopPropagation();">

                        <div class="action-dropdown">

                            <button type="button"
                                    class="action-btn"
                                    onclick="toggleDropdown(event, this)">

                                ⋮

                            </button>

                            <div class="dropdown-content">

                                <a href="/Admin/UserDetails/@user.UserID">

                                    View

                                </a>

                            @if (user.Role == "Student")
                                {
                                    <a href="/Admin/EditStudent/@user.UserID">
                                        Edit
                                    </a>
                                }
                                else if (user.Role == "Lecturer")
                                {
                                    <a href="/Admin/EditLecturer/@user.UserID">
                                        Edit
                                    </a>
                                }
                                else if (user.Role == "Admin")
                                {
                                    <a href="/Admin/EditAdmin/@user.UserID">
                                        Edit
                                    </a>
                                }

                                <a href="/Admin/DisableUser/@user.UserID"
                                   onclick="return confirm('Disable this user?');">

                                    @(user.Status == "Inactive"
                                                                    ? "Enable"
                                                                    : "Disable")

                                </a>

                                <a href="/Admin/DeleteUser/@user.UserID"
                                   onclick="return confirm('Delete this user permanently?');">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>


    <!-- Pop Up - Select User -->

    <div id="userTypeModal" class="modal">

        <div class="user-type-modal">

            <span id="closeModalBtn" class="close-btn">
                &times;
            </span>

            <h2>Select User Type</h2>

            <div class="user-type-container">

                <!-- STUDENT -->

                <a href="/Admin/AddStudent"
                   class="user-card">

                    <img src="~/images/student.png" />

                    <h3>Student</h3>

                </a>

                <!-- LECTURER -->

                <a href="/Admin/AddLecturer"
                   class="user-card">

                    <img src="~/images/lecturer.png" />

                    <h3>Lecturer</h3>

                </a>

                <!-- ADMIN -->

                <a href="/Admin/AddAdmin"
                   class="user-card">

                    <img src="~/images/admin.png" />

                    <h3>Admin</h3>

                </a>

            </div>

        </div>

    </div>
</div>

<script>

    const modal =
        document.getElementById("userTypeModal");

    const openBtn =
        document.getElementById("openModalBtn");

    const closeBtn =
        document.getElementById("closeModalBtn");

    openBtn.onclick = function () {

        modal.style.display = "block";

    }

    closeBtn.onclick = function () {

        modal.style.display = "none";

    }

    window.onclick = function (event) {

        if (event.target == modal) {

            modal.style.display = "none";

        }

    }

        const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("#usersTable tr");

        rows.forEach(row => {

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";
        });
    });

</script>


<script>

    function toggleDropdown(event, button)
    {
        event.stopPropagation();

        // CLOSE ALL DROPDOWNS

        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                if (menu !== button.nextElementSibling)
                {
                    menu.classList.remove("show");
                }
            });

        // TOGGLE CURRENT

        button.nextElementSibling
            .classList.toggle("show");
    }

    // CLOSE WHEN CLICK OUTSIDE

    document.addEventListener("click", function ()
    {
        document
            .querySelectorAll(".dropdown-content")
            .forEach(menu =>
            {
                menu.classList.remove("show");
            });
    });

</script>



