@model List<UniManage.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
}




<div class="table-container">

    <div class="table-top">

        <!-- FILTER -->

        <form method="get">

            <select name="roleFilter"
                    class="filter-dropdown"
                    onchange="this.form.submit()">

                <option value="ALL"
                        selected="@(Context.Request.Query["roleFilter"] == "ALL" || string.IsNullOrEmpty(Context.Request.Query["roleFilter"]) ? "selected" : null)">
                    ALL
                </option>

                <option value="Student"
                        selected="@(Context.Request.Query["roleFilter"] == "Student" ? "selected" : null)">
                    Students
                </option>

                <option value="Lecturer"
                        selected="@(Context.Request.Query["roleFilter"] == "Lecturer" ? "selected" : null)">
                    Lecturers
                </option>

                <option value="Admin"
                        selected="@(Context.Request.Query["roleFilter"] == "Admin" ? "selected" : null)">
                    Administrator
                </option>

            </select>

        </form>

        <!-- SEARCH -->

        <div class="table-search">

            <input type="text"
                   id="searchInput"
                   placeholder="Search users..." />

        </div>

        <!-- ADD USER -->

        <button id="openModalBtn"
                class="add-user-btn">

            Add User

        </button>

    </div>



    <table>

        <thead>

            <tr>

                <th>ID</th>

                <th>Full Name</th>

                <th>Department</th>

                <th>Role</th>

                <th>Email</th>

                <th>Phone</th>

                <th>Status</th>

                <th>Created Date</th>

                

            </tr>

        </thead>

        <tbody id="usersTable">

            @foreach (var user in Model)
            {
                <tr>

                    <td>@user.UserID</td>

                    <td>@user.FullName</td>

                    <td>@user.Department</td>

                    <td>@user.Role</td>

                    <td>@user.Email</td>

                    <td>@user.Phone</td>

                    <td>

                        <span class="status-active">

                            Active

                        </span>

                    </td>

                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>

                </tr>
            }

        </tbody>

    </table>


    <!-- Pop Up - Select User -->

    <div id="userTypeModal" class="modal">

        <div class="user-type-modal">

            <span id="closeModalBtn" class="close-btn">
                &times;
            </span>

            <h2>Select User Type</h2>

            <div class="user-type-container">

                <!-- STUDENT -->

                <a href="/Admin/AddStudent"
                   class="user-card">

                    <img src="~/images/student.png" />

                    <h3>Student</h3>

                </a>

                <!-- LECTURER -->

                <a href="/Admin/AddLecturer"
                   class="user-card">

                    <img src="~/images/lecturer.png" />

                    <h3>Lecturer</h3>

                </a>

                <!-- ADMIN -->

                <a href="/Admin/AddAdmin"
                   class="user-card">

                    <img src="~/images/admin.png" />

                    <h3>Admin</h3>

                </a>

            </div>

        </div>

    </div>
</div>

<script>

    const modal =
        document.getElementById("userTypeModal");

    const openBtn =
        document.getElementById("openModalBtn");

    const closeBtn =
        document.getElementById("closeModalBtn");

    openBtn.onclick = function () {

        modal.style.display = "block";

    }

    closeBtn.onclick = function () {

        modal.style.display = "none";

    }

    window.onclick = function (event) {

        if (event.target == modal) {

            modal.style.display = "none";

        }

    }

        const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("#usersTable tr");

        rows.forEach(row => {

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";
        });
    });

</script>



