@model UniManage.Models.AddAdminViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Admin";
}

<div class="page-header">

    <h1>Edit Administrator</h1>

    <p>
        Update administrator account details
    </p>

</div>

<div class="form-container">

    <form asp-action="EditAdmin"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="UserID" />

        <!-- PROFILE PICTURE -->

        <div class="profile-upload-section">

            <div class="profile-preview">

                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img id="profilePreview"
                         src="~/images/@Model.ProfileImage"
                         alt="Profile Preview" />
                }
                else
                {
                    <img id="profilePreview"
                         src="~/images/default-user.png"
                         alt="Profile Preview" />
                }

            </div>

            <div class="upload-controls">

                <label class="upload-btn">

                    Upload Profile Picture

                    <input type="file"
                           asp-for="ProfileImageFile"
                           id="profileImageInput"
                           accept="image/*"
                           hidden />

                </label>

                <p class="upload-text">
                    JPG, PNG or JPEG
                </p>

            </div>

        </div>

        <!-- PERSONAL INFORMATION -->

        <div class="form-section">

            <h2>Personal Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Full Name</label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Enter full name" />

                </div>

                <div class="form-group">

                    <label>Email Address</label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter email address" />

                </div>

                <div class="form-group">

                    <label>Address</label>

                    <input asp-for="Address"
                           class="form-control"
                           placeholder="Enter address" />

                </div>

                <div class="form-group">

                    <label>Phone Number</label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter phone number" />

                </div>

                <div class="form-group">

                    <label>Date of Birth</label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-control" />

                </div>

                <div class="form-group">

                    <label>Gender</label>

                    <select asp-for="Gender"
                            class="form-control">

                        <option>Male</option>
                        <option>Female</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- ADMINISTRATIVE INFORMATION -->

        <div class="form-section">

            <h2>Administrative Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Department</label>

                    <select asp-for="Department"
                            class="form-control">

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department.DepartmentName">
                                @department.DepartmentName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Position</label>

                    <input type="text"
                           class="form-control"
                           value="Administrator"
                           readonly />

                </div>

                <div class="form-group">

                    <label>Office Location</label>

                    <input type="text"
                           class="form-control"
                           value="Main Office"
                           readonly />

                </div>

                <div class="form-group">

                    <label>Access Level</label>

                    <select class="form-control"
                            disabled>

                        <option>System Admin</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- ACCOUNT INFORMATION -->

        <div class="form-section">

            <h2>Account Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Status</label>

                    <select asp-for="Status"
                            class="form-control">

                        <option>Active</option>
                        <option>Inactive</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- BUTTONS -->

        <div class="button-group">

            <a href="/Admin/Users"
               class="cancel-btn">

                Cancel

            </a>

            <button type="submit"
                    class="save-btn">

                Update Administrator

            </button>

        </div>

    </form>

</div>

<script>

    const profileInput =
        document.getElementById("profileImageInput");

    const profilePreview =
        document.getElementById("profilePreview");

    profileInput.addEventListener("change", function () {

        const file = this.files[0];

        if (file)
        {
            const reader = new FileReader();

            reader.onload = function (e)
            {
                profilePreview.src = e.target.result;
            }

            reader.readAsDataURL(file);
        }

    });

</script>