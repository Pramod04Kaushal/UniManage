@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports";
}

<div class="reports-wrapper">

    <div class="reports-hero">

        <div>
            <h3>University Performance Dashboard</h3>

            <p>
                View student, lecturer, course and
                enrollment analytics in one place.
            </p>
        </div>

        <div class="hero-badge">
            Live Reports
        </div>

    </div>

    <!-- SUMMARY CARDS -->

    <div class="reports-stats">

        <div class="report-card active"
             id="studentCard"
             onclick="showSection('studentSection', this)">

            <h4>Total Students</h4>
            <h2>@ViewBag.TotalStudents</h2>

        </div>

        <div class="report-card"
             id="lecturerCard"
             onclick="showSection('lecturerSection', this)">

            <h4>Total Lecturers</h4>
            <h2>@ViewBag.TotalLecturers</h2>

        </div>

        <div class="report-card"
             id="courseCard"
             onclick="showSection('courseSection', this)">

            <h4>Total Courses</h4>
            <h2>@ViewBag.TotalCourses</h2>

        </div>

        <div class="report-card"
             id="enrollmentCard"
             onclick="showSection('enrollmentSection', this)">

            <h4>Total Enrollments</h4>
            <h2>@ViewBag.TotalEnrollments</h2>

        </div>

    </div>

    <!-- CHART -->

        <div class="report-content">

        <div id="studentSection">

            <h2>Student Analytics</h2>

            <div class="analytics-card">

                <h4>Students by Department</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>
                            <th>Department</th>
                            <th>Students</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.StudentDepartments)
                        {
                            <tr>
                                <td>@item.Department</td>
                                <td>@item.Count</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Students by Course</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>

                            <th>Course</th>
                            <th>Students</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.StudentCourses)
                        {
                            <tr>

                                <td>@item.CourseName</td>

                                <td>@item.Count</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Latest Students</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Email</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var student in ViewBag.LatestStudents)
                        {
                            <tr>

                                <td>@student.FullName</td>

                                <td>@student.Email</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div id="lecturerSection" style="display:none;">

            <h2>Lecturer Analytics</h2>

            <div class="analytics-card">

                <h4>Lecturers by Department</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>
                            <th>Department</th>
                            <th>Lecturers</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.LecturerDepartments)
                        {
                            <tr>
                                <td>@item.Department</td>
                                <td>@item.Count</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Latest Lecturers</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var lecturer in ViewBag.LatestLecturers)
                        {
                            <tr>
                                <td>@lecturer.FullName</td>
                                <td>@lecturer.Email</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div id="courseSection" style="display:none;">

            <h2>Course Analytics</h2>

            <div class="analytics-card">

                <h4>Courses by Department</h4>

                <table class="analytics-table">

                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Courses</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.CourseDepartments)
                        {
                            <tr>
                                <td>@item.Department</td>
                                <td>@item.Count</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Course Status</h4>

                <table class="analytics-table">

                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Count</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Active</td>
                            <td>@ViewBag.ActiveCourses</td>
                        </tr>

                        <tr>
                            <td>Inactive</td>
                            <td>@ViewBag.InactiveCourses</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Most Popular Courses</h4>

                <table class="analytics-table">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Students</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var course in ViewBag.PopularCourses)
                        {
                            <tr>
                                <td>@course.CourseName</td>
                                <td>@course.Students</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div id="enrollmentSection" style="display:none;">

            <h2>Enrollment Analytics</h2>

            <div class="analytics-card">

                <h4>Enrollment Status</h4>

                <table class="analytics-table">

                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Count</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Active</td>
                            <td>@ViewBag.ActiveEnrollments</td>
                        </tr>

                        <tr>
                            <td>Inactive</td>
                            <td>@ViewBag.InactiveEnrollments</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Latest Enrollments</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Course</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.LatestEnrollments)
                        {
                            <tr>

                                <td>@item.StudentName</td>

                                <td>@item.CourseName</td>

                                <td>
                                    @item.EnrollmentDate.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="analytics-card">

                <h4>Enrollments by Course</h4>

                <table class="analytics-table">

                    <thead>

                        <tr>
                            <th>Course</th>
                            <th>Students</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.EnrollmentCourses)
                        {
                            <tr>

                                <td>@item.CourseName</td>

                                <td>@item.Count</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        </div>

    <script>

        function showSection(sectionId, card)
        {
            document.getElementById("studentSection").style.display = "none";
            document.getElementById("lecturerSection").style.display = "none";
            document.getElementById("courseSection").style.display = "none";
            document.getElementById("enrollmentSection").style.display = "none";

            document.getElementById(sectionId).style.display = "block";

            document.querySelectorAll(".report-card")
                .forEach(x => x.classList.remove("active"));

            card.classList.add("active");
        }

    </script>

</div>

