@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Module";
}

<div class="form-container">

    <form asp-controller="Admin"
          asp-action="AddModule"
          method="post"
          enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- MODULE INFORMATION -->

        <div class="form-section">

            <h2>Module Information</h2>

            <div class="form-grid">

                <!-- Module Name -->
                <div class="form-group">

                    <label>Module Name</label>

                    <input type="text"
                           name="ModuleName"
                           class="form-control"
                           placeholder="Enter module name" />

                </div>

                <!-- Module Code -->
                <div class="form-group">

                    <label>Module Code</label>

                    <input type="text"
                           name="ModuleCode"
                           class="form-control"
                           value="@ViewBag.ModuleCode"
                           readonly />

                </div>




                    <!-- Department -->
                    <div class="form-group">

                        <label>Department</label>

                    <select name="Department"
                            id="departmentSelect"
                            class="form-control">

                        <option>Select Department</option>

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department.DepartmentName">
                                @department.DepartmentName
                            </option>
                        }

                    </select>

                    </div>

                <!-- Credits -->
                <div class="form-group">

                    <label>Credits</label>

                    <input type="number"
                           name="Credits"
                           class="form-control"
                           placeholder="Enter credits" />

                </div>

            </div>

        </div>

        <!-- MODULE MATERIALS -->

        <div class="form-section">

            <h2>Module Materials</h2>

            <div class="materials-grid">

                <!-- PDF -->
                <div class="form-group">

                    <label>Upload PDF Notes</label>

                    <input type="file"
                           name="PdfFile"
                           class="form-control"
                           accept=".pdf" />

                </div>

                <!-- Presentation -->
                <div class="form-group">

                    <label>Upload Presentation</label>

                    <input type="file"
                           name="PresentationFile"
                           class="form-control"
                           accept=".ppt,.pptx" />

                </div>

                <!-- Video -->
                <div class="form-group">

                    <label>Upload Video Lecture</label>

                    <input type="file"
                           name="VideoFile"
                           class="form-control"
                           accept="video/*" />

                </div>

            </div>

        </div>








        <!-- MODULE DESCRIPTION -->

        <div class="form-section">

            <h2>Module Description</h2>
            <div class="form-group">

                <label>Description</label>

<textarea name="Description"
          class="form-control textarea"
          placeholder="Enter course description"></textarea>

            </div>

        </div>

        <!-- LECTURER INFORMATION -->

        <div class="form-section">

            <h2>Lecturer Assignment</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Assign Lecturer</label>

                    <select name="LecturerID"
                            id="lecturerSelect"
                            class="form-control">

                        <option value="0">Select Lecturer</option>

                        @foreach (var lecturer in ViewBag.Lecturers)
                        {
                            <option value="@lecturer.LecturerID"
                                    data-department="@lecturer.Department">
                                @lecturer.FullName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Course Status</label>

                    <select name="Status"
                            class="form-control">

                        <option>Active</option>
                        <option>Inactive</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- BUTTONS -->

        <div class="button-group">

            <a href="/Admin/Courses"
               class="cancel-btn">

                Cancel

            </a>

            <button type="submit"
                    class="save-btn">

                Save Module

            </button>

        </div>

    </form>

    <script>

        const departmentSelect =
            document.getElementById("departmentSelect");

        const lecturerSelect =
            document.getElementById("lecturerSelect");

        departmentSelect.addEventListener("change", function () {

            const selectedDepartment =
                this.value;

            const lecturerOptions =
                lecturerSelect.querySelectorAll("option");

            lecturerOptions.forEach(option => {

                if (option.value === "0") {
                    option.hidden = false;
                    return;
                }

                const lecturerDepartment =
                    option.dataset.department;

                option.hidden =
                    lecturerDepartment !== selectedDepartment;
            });

            lecturerSelect.value = "0";
        });

    </script>

</div>
