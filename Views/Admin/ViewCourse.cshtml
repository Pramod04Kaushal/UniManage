@model UniManage.Models.Course

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "View Course";
}

<div class="form-container">

    <!-- COURSE INFORMATION -->

    <div class="form-section">

        <h2>Course Information</h2>

        <div class="form-grid">

            <div class="form-group">

                <label>Course Name</label>

                <input type="text"
                       class="form-control"
                       value="@Model.CourseName"
                       readonly />

            </div>

            <div class="form-group">

                <label>Department</label>

                <input type="text"
                       class="form-control"
                       value="@Model.Department"
                       readonly />

            </div>

            <div class="form-group">

                <label>Semesters</label>

                <input type="text"
                       class="form-control"
                       value="@Model.Semesters"
                       readonly />

            </div>

            <div class="form-group">

                <label>Duration</label>

                <input type="text"
                       class="form-control"
                       value="@Model.Duration"
                       readonly />

            </div>

            <div class="form-group">

                <label>Course Fee</label>

                <input type="text"
                       class="form-control"
                       value="Rs. @Model.CourseFee"
                       readonly />

            </div>

            <div class="form-group">

                <label>Qualification Type</label>

                <input type="text"
                       class="form-control"
                       value="@Model.QualificationType"
                       readonly />

            </div>

            <div class="form-group">

                <label>Intake</label>

                <input type="text"
                       class="form-control"
                       value="@Model.Intake"
                       readonly />

            </div>

        </div>

    </div>

    <!-- COURSE MODULES -->

    <div class="form-section">

        <h2>Course Modules</h2>

        <table class="module-table">

            <thead>

                <tr>

                    <th>Semester</th>
                    <th>Module Code</th>
                    <th>Module Name</th>
                    <th>Credits</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var module in ViewBag.CourseModules)
                {
                    <tr>

                        <td>@module.Semester</td>

                        <td>@module.ModuleCode</td>

                        <td>@module.ModuleName</td>

                        <td>@module.Credits</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- DESCRIPTION -->

    <div class="form-section">

        <h2>Description</h2>

        <div class="form-group">

            <label>Course Description</label>

            <textarea class="form-control textarea"
                      readonly>@Model.Description</textarea>

        </div>

    </div>



    <!-- BUTTONS -->

    <div class="button-group">

        <a href="/Admin/Courses"
           class="cancel-btn">

            Back

        </a>

    </div>

</div>