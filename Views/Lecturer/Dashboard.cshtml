@model List<UniManage.Models.Module>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Lecturer Dashboard";
}

<link rel="stylesheet" href="~/css/LecturerDashboard.css" />

<div class="dashboard-page">

    <!-- HERO SECTION -->

    <div class="hero-card">

        <div class="hero-left">

            <h1>
                Welcome Back,
                <span>@ViewBag.LecturerName</span>
            </h1>

            <p>
                Manage your modules, students and assignments efficiently.
            </p>

            <div class="hero-info">

                <div>
                    <strong>Department</strong>
                    <span>@ViewBag.Department</span>
                </div>

                <div>
                    <strong>Specialization</strong>
                    <span>@ViewBag.Specialization</span>
                </div>

            </div>

        </div>

        <div class="hero-right">
            <i class="fas fa-chalkboard-teacher"></i>
        </div>

    </div>

    <!-- STATISTICS -->

    <div class="stats-grid">

        <a asp-controller="Lecturer"
           asp-action="MyModules"
           class="stat-card stat-link">

            <div class="icon blue">
                <i class="fas fa-book"></i>
            </div>

            <div>
                <h2>@ViewBag.TotalModules</h2>
                <p>Total Modules</p>
            </div>

        </a>

        <a asp-controller="Lecturer"
           asp-action="Students"
           class="stat-card stat-link">

            <div class="icon green">
                <i class="fas fa-user-graduate"></i>
            </div>

            <div>
                <h2>@ViewBag.TotalStudents</h2>
                <p>Total Students</p>
            </div>

        </a>

        <a asp-controller="Lecturer"
           asp-action="Assignments"
           class="stat-card stat-link">

            <div class="icon orange">
                <i class="fas fa-file-alt"></i>
            </div>

            <div>
                <h2>@ViewBag.TotalAssignments</h2>
                <p>Assignments</p>
            </div>

        </a>

        <a asp-controller="Lecturer"
           asp-action="Assignments"
           class="stat-card stat-link">

            <div class="icon red">
                <i class="fas fa-clock"></i>
            </div>

            <div>
                <h2>@ViewBag.PendingReviews</h2>
                <p>Pending Reviews</p>
            </div>

        </a>

    </div>

    <!-- QUICK ACTIONS -->

    <div class="section-card">

        <div class="section-header">
            <h2>Quick Actions</h2>
        </div>

        <div class="action-grid">

            <a asp-controller="Lecturer"
               asp-action="CreateAssignment"
               class="action-card">

                <i class="fas fa-plus-circle"></i>
                <span>Create Assignment</span>

            </a>

            <a asp-controller="Lecturer"
               asp-action="Assignments"
               class="action-card">

                <i class="fas fa-tasks"></i>
                <span>Grade Work</span>

            </a>

            <a asp-controller="Lecturer"
               asp-action="Reports"
               class="action-card">

                <i class="fas fa-chart-line"></i>
                <span>Reports</span>

            </a>



        </div>

    </div>

    <!-- MODULES TABLE -->

    <div class="section-card">

        <div class="table-header">

            <h2>My Modules</h2>

            <span class="module-count">
                @Model.Count Modules
            </span>

        </div>

        <table class="module-table">

            <thead>

                <tr>

                    <th>Module Code</th>

                    <th>Module Name</th>

                    <th>Department</th>

                    <th>Credits</th>

                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var module in Model)
                {
                    <tr>

                        <td>@module.ModuleCode</td>

                        <td>@module.ModuleName</td>

                        <td>@module.Department</td>

                        <td>@module.Credits</td>

                        <td>
                            <span class="status-badge">
                                @module.Status
                            </span>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>