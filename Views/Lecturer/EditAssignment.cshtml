@model UniManage.Models.Assignment

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Edit Assignment";
}

<link rel="stylesheet"
      href="~/css/admin-forms.css"
      asp-append-version="true" />

<div class="form-container">

    <div class="form-section">

        <h2>Edit Assignment</h2>

        <form asp-action="EditAssignment"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden"
                   asp-for="AssignmentID" />

            <div class="form-grid">

                <div class="form-group">

                    <label>Assignment Title</label>

                    <input asp-for="Title"
                           class="form-control" />

                </div>

                <div class="form-group">

                    <label>Course</label>

                    <select asp-for="CourseID"
                            class="form-control"
                            id="courseDropdown">

                        @foreach (var course in ViewBag.Courses)
                        {
                            <option value="@course.CourseID">
                                @course.CourseName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Module</label>

                    <select asp-for="ModuleID"
                            class="form-control"
                            id="moduleDropdown">

                        @foreach (var module in ViewBag.Modules)
                        {
                            <option value="@module.ModuleID">
                                @module.ModuleCode - @module.ModuleName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Batch</label>

                    <select asp-for="BatchID"
                            class="form-control"
                            id="batchDropdown">

                        @foreach (var batch in ViewBag.Batches)
                        {
                            <option value="@batch.BatchID">
                                @batch.BatchName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Deadline</label>

                    <input asp-for="Deadline"
                           type="datetime-local"
                           class="form-control" />

                </div>

            </div>

            <div class="form-group">

                <label>Description</label>

                <textarea asp-for="Description"
                          rows="5"
                          class="form-control"></textarea>

            </div>

            <div class="form-group">

                <label>Current Attachment</label>

                <input asp-for="AttachmentPath"
                       class="form-control"
                       readonly />

            </div>

            <button type="submit"
                    class="btn-primary">

                Update Assignment

            </button>

        </form>

    </div>

</div>