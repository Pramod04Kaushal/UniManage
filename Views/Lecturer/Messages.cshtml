@model List<UniManage.Models.LecturerMessageGroupViewModel>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Messages";
}

<link rel="stylesheet"
      href="~/css/Messages.css"
      asp-append-version="true" />

<div class="chat-container">

    <!-- LEFT SIDEBAR -->

    <div class="chat-sidebar">

        <div class="search-box">
            <input type="text"
                   id="chatSearch"
                   placeholder="Search chats..." />
        </div>

        <div class="chat-list">

            <!-- PRIVATE CHATS -->

            <div class="chat-section-title">
                Private Chats
            </div>

            @if (ViewBag.PrivateChats != null)
            {
                @foreach (var chat in ViewBag.PrivateChats)
                {
                    <a class="chat-user"
                       data-name="@chat.StudentName.ToLower()"
                       href="@Url.Action("PrivateChat",
                                             "Lecturer",
                                             new { chatId = chat.ChatID })">

                @if (!string.IsNullOrEmpty(chat.ProfileImage))
                        {
                            <img src="~/images/@chat.ProfileImage"
                                 class="group-avatar" />
                        }
                        else
                        {
                            <img src="~/images/default-user.png"
                                 class="group-avatar" />
                        }

                        <div class="chat-user-info">

                            <div class="chat-top">

                                <h6>@chat.StudentName</h6>

                        @if (chat.UnreadCount > 0)
                                {
                                    <span class="chat-badge">
                                        @chat.UnreadCount
                                    </span>
                                }

                            </div>

                            <small>Student</small>

                        </div>

                    </a>
                        }
            }

            <!-- GROUP CHATS -->

            <div class="chat-section-title">
                Group Chats
            </div>

            @foreach (var group in Model)
            {
                <a class="chat-user @(ViewBag.SelectedGroupId == group.GroupID ? "active" : "")"
                   data-name="@($"{group.CourseName} {group.BatchName}".ToLower())"
                   href="@Url.Action("Messages",
                                        "Lecturer",
                                        new { groupId = group.GroupID })">

                <img src="~/images/logo.png"
                     class="group-avatar" />

                    <div>
                        <h6>@group.CourseName | @group.BatchName</h6>

                        <small>
                            @group.StudentCount Students
                        </small>
                    </div>

                </a>
                        }

        </div>

    </div>

    <!-- RIGHT SIDE -->

    <div class="chat-main">

        @if (ViewBag.IsPrivateChat == true)
        {
            <!-- PRIVATE CHAT HEADER -->

            <div class="chat-header">

                <img src="@(string.IsNullOrEmpty(ViewBag.StudentProfileImage)
                             ? Url.Content("~/images/default-user.png")
                             : Url.Content("~/images/" + ViewBag.StudentProfileImage))"
                 class="group-avatar" />

                <div>
                    <h5>@ViewBag.StudentName</h5>
                    <small>Student</small>
                </div>

            </div>

            <!-- PRIVATE CHAT MESSAGES -->

            <div class="chat-body">

                @if (ViewBag.PrivateMessages != null)
                {
                    @foreach (var message in ViewBag.PrivateMessages)
                    {
                        bool isMine =
                        message.SenderUserID == (int)ViewBag.CurrentUserId;

                        <div class="message @(isMine ? "sent" : "received")">

                            <div class="sender-info">
                                <strong>@message.SenderName</strong>
                            </div>

                            @if (!string.IsNullOrEmpty(message.MessageText))
                            {
                                <div>
                                    @message.MessageText
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.FilePath))
                            {
                                var extension =
                                System.IO.Path.GetExtension(message.FileName)
                                .ToLower();

                                @if (extension == ".jpg" ||
                                                extension == ".jpeg" ||
                                                extension == ".png" ||
                                                extension == ".gif" ||
                                                extension == ".webp")
                                {
                                    <img src="@message.FilePath"
                                         class="chat-image" />
                                }
                                else
                                {
                                    <a href="@message.FilePath"
                                       target="_blank"
                                       class="chat-file">

                                        <i class="fas fa-file"></i>
                                        @message.FileName

                                    </a>
                                }
                            }

                            <div class="message-time">
                                @message.SentAt.ToString("hh:mm tt")
                            </div>

                        </div>
                    }
                    
                }

            </div>

            <!-- SEND PRIVATE MESSAGE -->

            <form asp-action="SendPrivateMessage"
                  asp-controller="Lecturer"
                  method="post"
                  enctype="multipart/form-data"
                  class="chat-footer">

                <input type="hidden"
                       name="chatId"
                       value="@ViewBag.ChatID" />

                <label for="privateFileInput"
                       class="attach-btn">

                    <i class="fas fa-paperclip"></i>

                </label>

                <input type="file"
                       id="privateFileInput"
                       name="file"
                       style="display:none;" />

                <span id="privateSelectedFile"></span>

                <input type="text"
                       name="messageText"
                       placeholder="Type message..." />

                <button type="submit">
                    <i class="fas fa-paper-plane"></i>
                </button>

            </form>
        }
        else if (ViewBag.SelectedGroupId != null)
        {
            <!-- GROUP HEADER -->

            <div class="chat-header">

                <img src="~/images/logo.png"
                     class="group-avatar" />

                <div>
                    <h5>@ViewBag.CourseName</h5>
                    <small>@ViewBag.BatchName</small>
                </div>

            </div>

            <!-- GROUP MESSAGES -->

            <div class="chat-body">

                @if (ViewBag.Messages != null)
                {
                    @foreach (var message in ViewBag.Messages)
                    {
                        bool isMine =
                        message.SenderUserID ==
                        (int)ViewBag.CurrentUserId;

                        <div class="message @(isMine ? "sent" : "received")">

                            <div class="sender-info">
                                <strong>@message.SenderName</strong>
                            </div>

                            @if (!string.IsNullOrEmpty(message.MessageText))
                            {
                                <div>
                                    @message.MessageText
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(message.FilePath))
                            {
                                var extension =
                                System.IO.Path.GetExtension(message.FileName)
                                .ToLower();

                                @if (extension == ".jpg" ||
                                                extension == ".jpeg" ||
                                                extension == ".png" ||
                                                extension == ".gif" ||
                                                extension == ".webp")
                                {
                                    <img src="@message.FilePath"
                                         class="chat-image" />
                                }
                                else
                                {
                                    <a href="@message.FilePath"
                                       target="_blank"
                                       class="chat-file">

                                        <i class="fas fa-file"></i>
                                        @message.FileName

                                    </a>
                                }
                            }

                            <div class="message-time">
                                @message.SentAt.ToString("hh:mm tt")
                            </div>

                        </div>
                    }
                }

            </div>

            <!-- SEND GROUP MESSAGE -->

            <form asp-controller="Lecturer"
                  asp-action="SendGroupMessage"
                  method="post"
                  enctype="multipart/form-data"
                  class="chat-footer">

                <input type="hidden"
                       name="groupId"
                       value="@ViewBag.SelectedGroupId" />

                <label for="fileInput"
                       class="attach-btn">
                    <i class="fas fa-paperclip"></i>
                </label>

                <input type="file"
                       id="fileInput"
                       name="file"
                       style="display:none;" />

                <span id="selectedFile"></span>

                <input type="text"
                       name="messageText"
                       placeholder="Type message..." />

                <button type="submit">
                    <i class="fas fa-paper-plane"></i>
                </button>

            </form>
        }
        else
        {
            <div class="d-flex justify-content-center align-items-center h-100">

                <h5 class="text-muted">
                    Select a chat to start messaging
                </h5>

            </div>
        }

    </div>

</div>

<script>
    const fileInput = document.getElementById("fileInput");

    if (fileInput) {
        fileInput.addEventListener("change", function () {

            if (this.files.length > 0) {
                document.getElementById("selectedFile")
                    .innerText = this.files[0].name;
            }
        });
    }
</script>

<script>
    document.getElementById("privateFileInput")
    ?.addEventListener("change", function () {

        if (this.files.length > 0) {

            document.getElementById("privateSelectedFile")
                .innerText = this.files[0].name;
        }

    });
</script>


<script>
    document.getElementById("chatSearch")
        .addEventListener("keyup", function () {

            let searchText = this.value.toLowerCase();

            let chats =
                document.querySelectorAll(".chat-user");

            chats.forEach(function (chat) {

                let name =
                    chat.getAttribute("data-name");

                if (name && name.includes(searchText))
                {
                    chat.style.display = "flex";
                }
                else
                {
                    chat.style.display = "none";
                }

            });

        });
</script>