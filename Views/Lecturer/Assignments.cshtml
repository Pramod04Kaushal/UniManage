@model List<UniManage.Models.Assignment>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Assignments";
}

<link rel="stylesheet"
      href="~/css/Assignments.css"
      asp-append-version="true" />

<div class="dashboard-container">

    <div class="table-top">

        <select id="moduleFilter"
                class="module-filter">

            <option value="">All Modules</option>

            @foreach (var module in ViewBag.Modules)
            {
                <option value="@module.ModuleID">
                    @module.ModuleName
                </option>
            }

        </select>

        <div class="filters">

            <input type="text"
                   id="searchInput"
                   class="search-box"
                   placeholder="Search assignment..." />



        </div>

        <a asp-action="CreateAssignment"
           class="create-btn">

            Create Assignment

        </a>

    </div>

    <div class="assignments-container">

        <table class="assignments-table">

            <thead>

                <tr>

                    <th>Title</th>
                    <th>Course ID</th>
                    <th>Module ID</th>
                    <th>Deadline</th>
                    <th>Created</th>
                    <th>Submissions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr data-module="@item.ModuleID"
                        ondblclick="location.href='@Url.Action("EditAssignment", "Lecturer", new { id = item.AssignmentID })'"
                        style="cursor:pointer;">

                        <td>
                            <span class="assignment-title">
                                @item.Title
                            </span>
                        </td>

                        <td>@item.CourseID</td>

                        <td>@item.ModuleID</td>

                        <td>
                            <span class="deadline-badge">
                                @item.Deadline.ToString("dd MMM yyyy")
                            </span>
                        </td>

                        <td>
                            <span class="created-date">
                                @item.CreatedAt.ToString("dd MMM yyyy")
                            </span>
                        </td>

                        <td>

                            <a asp-action="Submissions"
                               asp-route-id="@item.AssignmentID"
                               class="submission-btn">

                                View Submissions

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <script>

        const searchInput =
            document.getElementById("searchInput");

        const moduleFilter =
            document.getElementById("moduleFilter");

        const rows =
            document.querySelectorAll(".assignments-table tbody tr");

        function filterTable() {

            const search =
                searchInput.value.toLowerCase();

            const module =
                moduleFilter.value;

            rows.forEach(row => {

                const title =
                    row.children[0].innerText.toLowerCase();

                const moduleId =
                    row.dataset.module;

                const matchSearch =
                    title.includes(search);

                const matchModule =
                    module === "" || moduleId === module;

                row.style.display =
                    matchSearch && matchModule
                        ? ""
                        : "none";
            });
        }

        searchInput.addEventListener(
            "keyup",
            filterTable
        );

        moduleFilter.addEventListener(
            "change",
            filterTable
        );

    </script>

</div>