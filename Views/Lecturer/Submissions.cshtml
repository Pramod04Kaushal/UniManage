@model List<UniManage.Models.SubmissionViewModel>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Student Submissions";
}

<link rel="stylesheet"
      href="~/css/Submissions.css"
      asp-append-version="true" />

<div class="assignment-card">

    <span class="assignment-label">
        Assignment
    </span>

    <h2>@ViewBag.AssignmentTitle</h2>

    <p>@ViewBag.ModuleName</p>

    <div class="assignment-footer">

        <div class="deadline-badge">

            Deadline:
            @(((DateTime?)ViewBag.Deadline)?
                        .ToString("dd MMM yyyy"))

        </div>

        <div class="mini-stats">

            <div class="mini-stat">
                Total:
                <strong>@ViewBag.TotalSubmissions</strong>
            </div>

            <div class="mini-stat">
                Graded:
                <strong>@ViewBag.GradedCount</strong>
            </div>

            <div class="mini-stat">
                Pending:
                <strong>@ViewBag.PendingCount</strong>
            </div>

        </div>

    </div>

</div>

<div class="table-top">

    <div class="table-search">
        <input type="text"
               id="searchInput"
               placeholder="Search submissions..." />
    </div>

</div>

<div class="submissions-container">

    <table class="submissions-table">

        <thead>
            <tr>
                <th>Student Name</th>
                <th>Registration No</th>
                <th>Submitted Date</th>
                <th>Status</th>
                <th>Grade</th>
                <th>File</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.StudentName</td>

                    <td>@item.RegNum</td>

                    <td>
                        @item.SubmissionDate.ToString("dd MMM yyyy")
                    </td>

                    <td>
                        @if (item.Status == "Graded")
                        {
                            <span class="status-badge graded">
                                ✓ Graded
                            </span>
                        }
                        else
                        {
                            <span class="status-badge submitted">
                                Submitted
                            </span>
                        }
                    </td>

                    <td>
                        @if (item.Grade != null)
                        {
                            <span class="grade-pill">
                                @item.Grade%
                            </span>
                        }
                        else
                        {
                            <span class="grade-pill pending">
                                -
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="DownloadSubmission"
                           asp-route-id="@item.SubmissionID"
                           class="download-btn">
                            Download
                        </a>
                    </td>

                    <td>
                        <a asp-action="GradeSubmission"
                           asp-route-id="@item.SubmissionID"
                           class="grade-btn">
                            Grade
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>