@model IEnumerable<UniManage.Models.Module>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "My Modules";
}

<h2>My Modules</h2>

<table class="table">
    <thead>
        <tr>
            <th>Module Name</th>
            <th>Module Code</th>
            <th>Department</th>
            <th>Credits</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var module in Model)
        {
            <tr ondblclick="window.location='@Url.Action("ModuleDetails", "Lecturer", new { id = module.ModuleID })'"
                style="cursor:pointer;">
                <td>@module.ModuleName</td>
                <td>@module.ModuleCode</td>
                <td>@module.Department</td>
                <td>@module.Credits</td>

            </tr>
        }
    </tbody>
</table>