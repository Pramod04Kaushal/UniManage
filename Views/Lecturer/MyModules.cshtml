@model IEnumerable<UniManage.Models.Module>

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "My Modules";
}

<link rel="stylesheet"
      href="~/css/MyModules.css"
      asp-append-version="true" />

<div class="page-header">

    <div class="module-count">

        Total Modules:
        <strong>@Model.Count()</strong>

    </div>

    <div class="table-search">

        <input type="text"
               id="searchInput"
               placeholder="Search modules..." />

    </div>

</div>

<div class="modules-container">

    <table class="modules-table">

        <thead>

            <tr>
                <th>Module Name</th>
                <th>Module Code</th>
                <th>Department</th>
                <th>Credits</th>
            </tr>

        </thead>

        <tbody id="modulesTable">

            @foreach (var module in Model)
            {
                <tr ondblclick="window.location='@Url.Action("ModuleDetails", "Lecturer", new { id = module.ModuleID })'">

                    <td>@module.ModuleName</td>

                    <td>

                        <span class="module-code">
                            @module.ModuleCode
                        </span>

                    </td>

                    <td>@module.Department</td>

                    <td>

                        <span class="credit-badge">
                            @module.Credits Credits
                        </span>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<script>

    const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("#modulesTable tr");

        rows.forEach(row => {

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";

        });

    });

</script>