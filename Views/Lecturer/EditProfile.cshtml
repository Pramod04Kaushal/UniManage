@model UniManage.Models.User

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<link rel="stylesheet"
      href="~/css/LecturerProfile.css"
      asp-append-version="true" />

<div class="profile-dashboard">


    <div class="profile-header-card">

        <div class="profile-left">

            <img src="@(string.IsNullOrEmpty(Model.ProfileImage)
                              ? "/images/default-user.png"
                              : "/images/" + Model.ProfileImage)"
                 class="header-avatar" />

            <div class="profile-info">

                <h2>@Model.FullName</h2>

                <p>@Model.Role • @Model.Department</p>

            </div>

        </div>

        <div class="profile-right">

            <label for="profileImage"
                   class="upload-btn">

                Change Photo

            </label>

            <input type="file"
                   id="profileImage"
                   name="profileImage"
                   hidden />

        </div>

    </div>

    <form asp-action="EditProfile"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="UserID" />

        <div class="form-section">

            <div class="section-title">

                <i class="fas fa-user"></i>

                <h2>Personal Information</h2>

            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label>Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Address</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Date Of Birth</label>
                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Gender</label>
                    <select asp-for="Gender"
                            class="form-control">

                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>

                    </select>
                </div>



            </div>

        </div>

        <div class="button-group">

            <a asp-action="Profile"
               class="cancel-btn">

                Cancel

            </a>

            <button type="submit"
                    class="save-btn">

                Save Changes

            </button>

        </div>

    </form>


</div>
