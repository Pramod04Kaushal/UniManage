@model UniManage.Models.User

@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

@if (Model == null)
{
    <h2>User Not Found</h2>
    return;
}

<link rel="stylesheet"
      href="~/css/LecturerProfile.css"
      asp-append-version="true" />

<div class="profile-dashboard">


    <!-- HERO SECTION -->

    <div class="profile-banner">

        <div class="banner-content">

            <div class="banner-left">

                <img src="@(string.IsNullOrEmpty(Model.ProfileImage)
                                                          ? "/images/default-user.png"
                                                          : "/images/" + Model.ProfileImage)"
                     class="profile-avatar" />

                <div>

                    <h1>@Model.FullName</h1>

                    <p>
                        @Model.Role • @Model.Department
                    </p>

                </div>

            </div>

            <div class="banner-right">

                <a asp-action="EditProfile"
                   class="profile-btn">

                    Change Profile Picture

                </a>

                <button type="button"
                        class="profile-btn password-btn"
                        onclick="openPasswordModal()">

                    Change Password

                </button>

            </div>

        </div>

    </div>





    <!-- MAIN CONTENT -->

    <div class="profile-layout">

        <!-- LEFT SIDEBAR -->

        <div class="profile-sidebar">
        </div>

        <!-- RIGHT CONTENT -->

        <div class="profile-content">

            <!-- PERSONAL -->

            <div class="info-section">

                <div class="section-header">

                    <i class="fas fa-user"></i>

                    <h3>Personal Information</h3>

                </div>

                <div class="info-grid">

                    <div class="info-box">

                        <label>Full Name</label>

                        <p>@Model.FullName</p>

                    </div>

                    <div class="info-box">

                        <label>Email Address</label>

                        <p>@Model.Email</p>

                    </div>

                    <div class="info-box">

                        <label>Username</label>

                        <p>@Model.Username</p>

                    </div>

                    <div class="info-box">

                        <label>Phone Number</label>

                        <p>@Model.Phone</p>

                    </div>

                </div>

            </div>

            <div class="info-section">

                <div class="section-header">

                    <i class="fas fa-chalkboard-teacher"></i>

                    <h3>Lecturer Information</h3>

                </div>

                <div class="info-grid">

                    <div class="info-box">

                        <label>Department</label>

                        <p>@Model.Department</p>

                    </div>

                    <div class="info-box">

                        <label>Role</label>

                        <p>@Model.Role</p>

                    </div>

                    <div class="info-box">

                        <label>Status</label>

                        <p>@Model.Status</p>

                    </div>

                    <div class="info-box">

                        <label>Joined Date</label>

                        <p>
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </p>

                    </div>

                </div>

            </div>

            <!-- ACCOUNT -->

            <div class="info-section">

                <div class="section-header">

                    <i class="fas fa-lock"></i>

                    <h3>Account Information</h3>

                </div>

                <div class="info-grid">

                    <div class="info-box">

                        <label>Role</label>

                        <p>@Model.Role</p>

                    </div>

                    <div class="info-box">

                        <label>Department</label>

                        <p>@Model.Department</p>

                    </div>

                    <div class="info-box">

                        <label>Created Date</label>

                        <p>
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </p>

                    </div>

                    <div class="info-box">

                        <label>Status</label>

                        <p>Active</p>

                    </div>

                </div>

            </div>





        </div>

    </div>

    <div id="passwordModal"
         class="modal-overlay">

        <div class="modal-box">

            <h3>Change Password</h3>

            <form asp-action="ChangePassword"
                  method="post">

                <div class="form-group">

                    <label>Current Password</label>

                    <input type="password"
                           name="currentPassword"
                           required />

                </div>

                <div class="form-group">

                    <label>New Password</label>

                    <input type="password"
                           name="newPassword"
                           required />

                </div>

                <div class="form-group">

                    <label>Confirm Password</label>

                    <input type="password"
                           name="confirmPassword"
                           required />

                </div>

                <div class="modal-buttons">

                    <button type="submit"
                            class="save-btn">

                        Update Password

                    </button>

                    <button type="button"
                            class="cancel-btn"
                            onclick="closePasswordModal()">

                        Cancel

                    </button>

                </div>

            </form>

        </div>

    </div>


</div>

<script>

    function openPasswordModal() {
        document.getElementById("passwordModal")
            .style.display = "flex";
    }

    function closePasswordModal() {
        document.getElementById("passwordModal")
            .style.display = "none";
    }

</script>
