<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniManage</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/LecturerLayout.css" asp-append-version="true" />

    <link rel="icon"
          type="image/x-icon"
          href="~/images/logo.png" />

</head>

<body>

    <div class="layout-container">

        <aside class="sidebar">

            <div class="sidebar-header">

                <img src="~/images/full.png"
                     alt="UniManage Logo"
                     class="sidebar-logo" />

            </div>

            <ul class="sidebar-menu">

                <li>
                    <a asp-controller="Lecturer" asp-action="Dashboard">
                        <i class="fas fa-home"></i>
                        Dashboard
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="MyModules">
                        <i class="fas fa-book"></i>
                        My Modules
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Assignments">
                        <i class="fas fa-file-alt"></i>
                        Assignments
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Assignments">
                        <i class="fas fa-check-circle"></i>
                        Grading
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Students">
                        <i class="fas fa-user-graduate"></i>
                        Students
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Reports">
                        <i class="fas fa-chart-bar"></i>
                        Reports
                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Messages">

                        <i class="fas fa-comments"></i>

                        <span>Messages</span>

                        @if (ViewBag.TotalUnreadMessages != null &&
                                                ViewBag.TotalUnreadMessages > 0)
                        {
                            <span class="sidebar-badge">
                                @ViewBag.TotalUnreadMessages
                            </span>
                        }

                    </a>
                </li>

                <li>
                    <a asp-controller="Lecturer"
                       asp-action="Profile">
                        <i class="fas fa-user"></i>
                        Profile
                    </a>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Login">
                        <i class="fas fa-sign-out-alt"></i>
                        Logout
                    </a>
                </li>

            </ul>

        </aside>

        <main class="main-content">

            <div class="topbar">

                <h4 class="portal-title">
                    Lecturer Portal
                    <span>| @ViewData["Title"]</span>
                </h4>

                <div class="profile-dropdown">

                    <div class="user-info profile-trigger">

                        @if (!string.IsNullOrEmpty(ViewBag.NavbarProfileImage))
                        {
                            <img src="~/images/@ViewBag.NavbarProfileImage"
                                 class="nav-profile-pic" />
                        }
                        else
                        {
                            <img src="~/images/default-user.png"
                                 class="nav-profile-pic" />
                        }

                        <span>@ViewBag.NavbarLecturerName</span>

                    </div>

                    <div class="dropdown-menu-custom">

                        <a asp-controller="Lecturer"
                           asp-action="Profile">

                            <i class="fas fa-user"></i>
                            My Profile

                        </a>

                        <a asp-controller="Account"
                           asp-action="Login">

                            <i class="fas fa-sign-out-alt"></i>
                            Logout

                        </a>

                    </div>

                </div>

            </div>

            <div class="content-wrapper">

                @RenderBody()

            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const dropdown =
                document.querySelector(".profile-dropdown");

            const trigger =
                document.querySelector(".profile-trigger");

            trigger?.addEventListener("click", function (e) {

                e.stopPropagation();

                dropdown.classList.toggle("active");

            });

            document.addEventListener("click", function () {

                dropdown?.classList.remove("active");

            });

        });
    </script>

</body>

</html>