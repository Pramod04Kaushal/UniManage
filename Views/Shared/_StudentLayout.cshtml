<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniManage</title>

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

</head>

<body>

    <div class="student-layout">

        <!-- TOP NAVBAR -->

        <div class="student-navbar">

            <div class="student-logo">

                <h2>UniManage</h2>

            </div>

            <div class="student-menu">

                <a asp-controller="Student"
                   asp-action="Dashboard">

                    Dashboard

                </a>

                <a href="#">

                    Courses

                </a>

                <a href="#">

                    Assignments

                </a>

                <a href="#">

                    Grades

                </a>

                <a asp-controller="Account"
                   asp-action="Login">

                    Logout

                </a>

            </div>

        </div>

        <!-- PAGE CONTENT -->

        <div class="student-content">

            @RenderBody()

        </div>

    </div>

</body>

</html>