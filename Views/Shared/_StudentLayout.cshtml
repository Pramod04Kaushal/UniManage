<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniManage</title>

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="~/css/Student.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="icon"
          type="image/x-icon"
          href="~/images/logo.png"  />



</head>

<body>

    <div class="student-layout">

        <!-- TOP NAVBAR -->


        <div class="student-navbar">

            <div class="student-logo">

                <a asp-controller="Student"
                   asp-action="Dashboard">

                    <img src="~/images/full.png"
                         alt="UniManage Logo" />

                </a>

            </div>

            <div class="navbar-right">

                <a asp-controller="Student"
                   asp-action="Messages"
                   class="message-btn">

                    <i class="fas fa-comments"></i>

                    @if (ViewBag.UnreadMessageCount > 0)
                    {
                        <span class="message-badge">
                            @ViewBag.UnreadMessageCount
                        </span>
                    }

                </a>

                <div class="profile-dropdown">

                    <button class="navbar-profile-btn"
                            onclick="toggleProfileMenu()">

                        <i class="fas fa-user-circle"></i>

                    </button>

                    <div id="profileMenu"
                         class="profile-menu">

                        <a asp-controller="Student"
                           asp-action="Profile">

                            <i class="fas fa-user"></i>
                            My Profile

                        </a>

                        <a asp-controller="Account"
                           asp-action="Logout">

                            <i class="fas fa-sign-out-alt"></i>
                            Logout

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- PAGE CONTENT -->

        <div class="student-content">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        function toggleProfileMenu() {

            document
                .getElementById("profileMenu")
                .classList
                .toggle("show");
        }

        window.onclick = function(event) {

            if (!event.target.closest('.profile-dropdown')) {

                document
                    .getElementById("profileMenu")
                    .classList
                    .remove("show");
            }
        }

    </script>

</body>

</html>