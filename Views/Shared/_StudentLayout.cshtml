<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniManage</title>

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="icon"
          type="image/x-icon"
          href="~/images/logo.png" />



</head>

<body>

    <div class="student-layout">

        <!-- TOP NAVBAR -->

        <div class="student-navbar">

            <div class="student-logo">

                <img src="~/images/logo.png"
                     alt="UniManage Logo" />

                <h2>UniManage</h2>

            </div>



        </div>

        <!-- PAGE CONTENT -->

        <div class="student-content">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</body>

</html>